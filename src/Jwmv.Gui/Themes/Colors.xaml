<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Shell: deep sidebar -->
  <Color x:Key="SidebarBgColor">#152238</Color>
  <Color x:Key="SidebarHoverColor">#24344F</Color>
  <Color x:Key="SidebarSelectedColor">#2A3A55</Color>
  <Color x:Key="SidebarTextColor">#E8EEF7</Color>
  <Color x:Key="SidebarMutedColor">#9BB0CC</Color>
  <Color x:Key="SidebarAccentColor">#2DD4BF</Color>

  <!-- Content: light surface -->
  <Color x:Key="ContentBgColor">#F4F6FA</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="BorderColor">#D0D7E2</Color>
  <Color x:Key="TextPrimaryColor">#0F172A</Color>
  <Color x:Key="TextSecondaryColor">#64748B</Color>
  <Color x:Key="TextMutedColor">#94A3B8</Color>

  <!-- Accents -->
  <Color x:Key="AccentColor">#0D9488</Color>
  <Color x:Key="AccentHoverColor">#0F766E</Color>
  <Color x:Key="AccentPressedColor">#115E59</Color>
  <Color x:Key="OnAccentColor">#FFFFFF</Color>
  <Color x:Key="DangerColor">#DC2626</Color>
  <Color x:Key="DangerHoverColor">#B91C1C</Color>
  <Color x:Key="SuccessColor">#15803D</Color>
  <Color x:Key="ErrorColor">#B91C1C</Color>
  <Color x:Key="ErrorBgColor">#FEF2F2</Color>
  <Color x:Key="ErrorBorderColor">#FECACA</Color>
  <Color x:Key="InfoBgColor">#ECFDF5</Color>
  <Color x:Key="InfoBorderColor">#A7F3D0</Color>
  <Color x:Key="FocusRingColor">#0D9488</Color>
  <Color x:Key="RowHoverColor">#F1F5F9</Color>
  <Color x:Key="RowSelectedColor">#CCFBF1</Color>
  <Color x:Key="StatusBarBgColor">#E8EEF5</Color>

  <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource SidebarHoverColor}" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{StaticResource SidebarSelectedColor}" />
  <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />
  <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource SidebarMutedColor}" />
  <SolidColorBrush x:Key="SidebarAccentBrush" Color="{StaticResource SidebarAccentColor}" />

  <SolidColorBrush x:Key="ContentBgBrush" Color="{StaticResource ContentBgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="BorderBrushToken" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerHoverBrush" Color="{StaticResource DangerHoverColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="ErrorBgBrush" Color="{StaticResource ErrorBgColor}" />
  <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}" />
  <SolidColorBrush x:Key="InfoBgBrush" Color="{StaticResource InfoBgColor}" />
  <SolidColorBrush x:Key="InfoBorderBrush" Color="{StaticResource InfoBorderColor}" />
  <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRingColor}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
  <SolidColorBrush x:Key="RowSelectedBrush" Color="{StaticResource RowSelectedColor}" />
  <SolidColorBrush x:Key="StatusBarBgBrush" Color="{StaticResource StatusBarBgColor}" />
</ResourceDictionary>
