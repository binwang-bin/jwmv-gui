<Window x:Class="Jwmv.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Jwmv.Gui.Localization"
        Title="{loc:Loc Window_Title}"
        Height="720"
        Width="1180"
        MinHeight="560"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom" Height="34" Padding="12,0">
      <StatusBarItem>
        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <ProgressBar Width="200"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding ProgressPercentage}"
                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
      </StatusBarItem>
    </StatusBar>

    <Border DockPanel.Dock="Left"
            Width="212"
            Background="{StaticResource SidebarBgBrush}"
            Padding="14,16">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="6,2,6,24">
          <TextBlock Text="jwmv"
                     FontSize="24"
                     FontWeight="Bold"
                     Foreground="White" />
          <TextBlock Text="{loc:Loc App_Subtitle}"
                     Foreground="{StaticResource SidebarMutedBrush}"
                     FontSize="12"
                     Margin="0,6,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel>
          <Button Command="{Binding NavigateCommand}"
                  CommandParameter="Overview"
                  ToolTip="{loc:Loc Nav_Overview}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedNav}" Value="Overview">
                    <Setter Property="Tag" Value="Selected" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,10,0"
                    Stretch="Uniform"
                    Fill="{StaticResource SidebarTextBrush}"
                    Data="{StaticResource IconOverview}" />
              <TextBlock Text="{loc:Loc Nav_Overview}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding NavigateCommand}" CommandParameter="Catalog" ToolTip="{loc:Loc Nav_Catalog}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedNav}" Value="Catalog">
                    <Setter Property="Tag" Value="Selected" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,10,0"
                    Stretch="Uniform"
                    Fill="{StaticResource SidebarTextBrush}"
                    Data="{StaticResource IconCatalog}" />
              <TextBlock Text="{loc:Loc Nav_Catalog}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding NavigateCommand}" CommandParameter="Installed" ToolTip="{loc:Loc Nav_Installed}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedNav}" Value="Installed">
                    <Setter Property="Tag" Value="Selected" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,10,0"
                    Stretch="Uniform"
                    Fill="{StaticResource SidebarTextBrush}"
                    Data="{StaticResource IconInstalled}" />
              <TextBlock Text="{loc:Loc Nav_Installed}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding NavigateCommand}" CommandParameter="Doctor" ToolTip="{loc:Loc Nav_Doctor}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedNav}" Value="Doctor">
                    <Setter Property="Tag" Value="Selected" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,10,0"
                    Stretch="Uniform"
                    Fill="{StaticResource SidebarTextBrush}"
                    Data="{StaticResource IconDoctor}" />
              <TextBlock Text="{loc:Loc Nav_Doctor}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip="{loc:Loc Nav_Settings}">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedNav}" Value="Settings">
                    <Setter Property="Tag" Value="Selected" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <Path Width="16" Height="16" Margin="0,0,10,0"
                    Stretch="Uniform"
                    Fill="{StaticResource SidebarTextBrush}"
                    Data="{StaticResource IconSettings}" />
              <TextBlock Text="{loc:Loc Nav_Settings}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Background="{StaticResource ContentBgBrush}">
      <Grid>
        <ContentControl Content="{Binding CurrentPage}" />
        <Border Background="#66F4F6FA"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                IsHitTestVisible="False" />
      </Grid>
    </Border>
  </DockPanel>
</Window>
