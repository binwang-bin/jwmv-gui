<UserControl x:Class="Jwmv.Gui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jwmv.Gui.Localization">
  <ScrollViewer Margin="24" VerticalScrollBarVisibility="Auto">
    <StackPanel>
      <DockPanel Margin="0,0,0,16">
        <TextBlock Text="{loc:Loc Settings_Title}" Style="{StaticResource PageTitleStyle}" />
        <Button Content="{loc:Loc Settings_Reload}"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Right"
                Margin="0" />
      </DockPanel>

      <Border Style="{StaticResource ErrorBannerStyle}"
              Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}" />
      </Border>
      <Border Style="{StaticResource InfoBannerStyle}"
              Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
        <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoBannerTextStyle}" />
      </Border>

      <GroupBox Header="{loc:Loc Settings_Language}">
        <StackPanel Orientation="Horizontal">
          <Button Content="{loc:Loc Language_English}"
                  Command="{Binding SetLanguageCommand}"
                  CommandParameter="en"
                  IsEnabled="{Binding IsChineseSelected}" />
          <Button Content="{loc:Loc Language_Chinese}"
                  Command="{Binding SetLanguageCommand}"
                  CommandParameter="zh"
                  IsEnabled="{Binding IsEnglishSelected}"
                  Margin="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{loc:Loc Settings_Configuration}">
        <StackPanel>
          <TextBlock Text="{loc:Loc Settings_ConfigReadonlyHint}"
                     Style="{StaticResource MutedTextStyle}"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{loc:Loc Settings_RootDirectory}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RootDirectory}" TextWrapping="Wrap" Margin="0,0,0,10"
                     ToolTip="{Binding RootDirectory}" />
          <TextBlock Grid.Row="1" Text="{loc:Loc Settings_ConfigFile}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConfigFilePath}" TextWrapping="Wrap" Margin="0,0,0,10"
                     ToolTip="{Binding ConfigFilePath}" />
          <TextBlock Grid.Row="2" Text="{loc:Loc Settings_PreferredDistribution}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PreferredDistributionAlias}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="3" Text="{loc:Loc Settings_CatalogRefreshHours}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CatalogRefreshHours}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="4" Text="{loc:Loc Settings_AutoEnv}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AutoEnvEnabled}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="5" Text="{loc:Loc Settings_DefaultShell}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DefaultShell}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="6" Text="{loc:Loc Settings_DefaultJavaAlias}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DefaultJavaAlias}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="7" Text="{loc:Loc Settings_DefaultVersions}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10" />
          <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DefaultVersionsText}" TextWrapping="Wrap" Margin="0,0,0,4"
                     ToolTip="{Binding DefaultVersionsText}" />
        </Grid>
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{loc:Loc Settings_CatalogCache}">
        <StackPanel>
          <Button Content="{loc:Loc Settings_RefreshCatalog}"
                  Command="{Binding RefreshCatalogCommand}"
                  HorizontalAlignment="Left"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Margin="0,0,0,12" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="{loc:Loc Settings_Archives}" IsChecked="{Binding FlushArchives}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Loc Settings_Temp}" IsChecked="{Binding FlushTemp}" Margin="0,0,12,0" />
            <CheckBox Content="{loc:Loc Settings_Catalog}" IsChecked="{Binding FlushCatalog}" />
          </StackPanel>
          <Button Content="{loc:Loc Settings_FlushSelected}"
                  Command="{Binding FlushCommand}"
                  HorizontalAlignment="Left"
                  Margin="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{loc:Loc Settings_UninstallSection}">
        <StackPanel>
          <TextBlock Text="{loc:Loc Settings_UninstallHint}"
                     TextWrapping="Wrap"
                     Style="{StaticResource MutedTextStyle}"
                     Margin="0,0,0,12" />
          <Button Content="{loc:Loc Settings_Uninstall}"
                  Command="{Binding UninstallProductCommand}"
                  Style="{StaticResource DangerButtonStyle}"
                  HorizontalAlignment="Left"
                  Margin="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{loc:Loc Settings_About}" Margin="0">
        <TextBlock Text="{Binding AboutText}" TextWrapping="Wrap" />
      </GroupBox>
    </StackPanel>
  </ScrollViewer>
</UserControl>
