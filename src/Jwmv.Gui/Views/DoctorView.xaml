<UserControl x:Class="Jwmv.Gui.Views.DoctorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jwmv.Gui.Localization">
  <DockPanel Style="{StaticResource PageRootStyle}">
    <TextBlock DockPanel.Dock="Top"
               Text="{loc:Loc Doctor_Title}"
               Style="{StaticResource PageTitleStyle}"
               Margin="0,0,0,16" />

    <Border DockPanel.Dock="Top" Style="{StaticResource ActionBarStyle}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Text="{loc:Loc Doctor_DiagnoseSection}"
                     Style="{StaticResource SectionCaptionStyle}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <Button Content="{loc:Loc Doctor_Run}"
                  Command="{Binding RunDoctorCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Margin="0,0,16,0" />
          <TextBlock Text="{loc:Loc Doctor_IntegrateSection}"
                     Style="{StaticResource SectionCaptionStyle}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <Button Content="{loc:Loc Doctor_Integrate}"
                  Command="{Binding IntegrateCommand}"
                  Margin="0,0,16,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{loc:Loc Doctor_CopySection}"
                     Style="{StaticResource SectionCaptionStyle}"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0" />
          <Button Content="{loc:Loc Doctor_CopyFindings}" Command="{Binding CopyFindingsCommand}" />
          <Button Content="{loc:Loc Doctor_CopyReport}"
                  Command="{Binding CopyReportCommand}"
                  Margin="0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Style="{StaticResource FilterBarStyle}">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
          <TextBlock Text="{loc:Loc Doctor_Profile}" Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ProfilePath}"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     ToolTip="{Binding ProfilePath}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{loc:Loc Doctor_ProfileIntegrated}" Style="{StaticResource MutedTextStyle}" Margin="0,0,8,0" />
          <TextBlock Text="{Binding ProfileIntegratedText}" Foreground="{StaticResource TextPrimaryBrush}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Style="{StaticResource ErrorBannerStyle}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="{loc:Loc Common_Retry}"
                Command="{Binding RunDoctorCommand}"
                Margin="8,0,0,0"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top"
            Style="{StaticResource InfoBannerStyle}"
            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
      <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoBannerTextStyle}" />
    </Border>

    <Grid IsEnabled="{Binding IsIdle}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.4*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Loc Doctor_Status}"
                   Style="{StaticResource SectionTitleStyle}" />
        <Grid>
          <DataGrid ItemsSource="{Binding Facts}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{loc:Loc Col_Name}" Binding="{Binding Name}" Width="180" />
              <DataGridTextColumn Header="{loc:Loc Col_Display}" Binding="{Binding Value}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource PathCellTextStyle}" />
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="{loc:Loc Empty_DoctorFacts}"
                     Style="{StaticResource EmptyStateStyle}"
                     Visibility="{Binding IsFactsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top"
                   Text="{loc:Loc Doctor_Findings}"
                   Style="{StaticResource SectionTitleStyle}" />
        <TextBox Text="{Binding FindingsText, Mode=OneWay}"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontFamily="Cascadia Mono, Consolas" />
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
