<UserControl x:Class="Jwmv.Gui.Views.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Jwmv.Gui.Localization">
  <DockPanel Style="{StaticResource PageRootStyle}">
    <TextBlock DockPanel.Dock="Top"
               Text="{loc:Loc Catalog_Title}"
               Style="{StaticResource PageTitleStyle}"
               Margin="0,0,0,10" />

    <!-- Browse: one compact row -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CompactToolbarStyle}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{loc:Loc Catalog_BrowseSection}" Style="{StaticResource InlineCaptionStyle}" />
          <TextBlock Text="{loc:Loc Catalog_Candidate}" Style="{StaticResource InlineFieldLabelStyle}" />
          <ComboBox Width="120"
                    Margin="0,0,12,0"
                    ItemsSource="{Binding CandidateNames}"
                    SelectedItem="{Binding SelectedCandidate}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Center" />
          <TextBlock Text="{loc:Loc Catalog_Filter}" Style="{StaticResource InlineFieldLabelStyle}" />
          <TextBox Width="140"
                   Margin="0,0,12,0"
                   Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsIdle}"
                   VerticalAlignment="Center" />
          <CheckBox Content="{loc:Loc Catalog_ForceRefresh}"
                    IsChecked="{Binding ForceRefresh}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Center" />
        </StackPanel>
        <Button DockPanel.Dock="Right"
                Content="{loc:Loc Common_Refresh}"
                Command="{Binding LoadCatalogCommand}"
                VerticalAlignment="Center"
                Margin="0" />
      </DockPanel>
    </Border>

    <!-- Install: one compact row -->
    <Border DockPanel.Dock="Top" Style="{StaticResource CompactToolbarStyle}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{loc:Loc Catalog_InstallSection}" Style="{StaticResource InlineCaptionStyle}" />
          <TextBlock Text="{loc:Loc Catalog_ManualVersion}" Style="{StaticResource InlineFieldLabelStyle}" />
          <TextBox Width="150"
                   Margin="0,0,12,0"
                   Text="{Binding ManualVersion, UpdateSourceTrigger=PropertyChanged}"
                   IsEnabled="{Binding IsIdle}"
                   VerticalAlignment="Center" />
          <CheckBox Content="{loc:Loc Catalog_SetAsDefault}"
                    IsChecked="{Binding SetAsDefault}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
          <CheckBox Content="{loc:Loc Catalog_AllowUnverified}"
                    IsChecked="{Binding AllowUnverified}"
                    IsEnabled="{Binding IsIdle}"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Loc Catalog_AllowUnverifiedTip}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="{loc:Loc Common_Cancel}" Command="{Binding CancelInstallCommand}" />
          <Button Content="{Binding InstallButtonText}"
                  Command="{Binding InstallSelectedCommand}"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Margin="0"
                  MinWidth="88" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top"
            Style="{StaticResource ErrorBannerStyle}"
            Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
      <DockPanel>
        <Button DockPanel.Dock="Right"
                Content="{loc:Loc Common_Retry}"
                Command="{Binding LoadCatalogCommand}"
                Margin="8,0,0,0"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorBannerTextStyle}" />
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top"
            Style="{StaticResource InfoBannerStyle}"
            Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}">
      <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoBannerTextStyle}" />
    </Border>

    <Grid>
      <DataGrid ItemsSource="{Binding Packages}"
                SelectedItem="{Binding SelectedPackage}"
                IsEnabled="{Binding IsIdle}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="{loc:Loc Col_Alias}" Binding="{Binding Alias}" Width="140" />
          <DataGridTextColumn Header="{loc:Loc Col_Version}" Binding="{Binding Version}" Width="120" />
          <DataGridTextColumn Header="{loc:Loc Col_Distribution}" Binding="{Binding Distribution}" Width="*" />
          <DataGridTextColumn Header="{loc:Loc Col_Checksum}" Binding="{Binding ChecksumType}" Width="100" />
          <DataGridTextColumn Header="{loc:Loc Col_Status}" Binding="{Binding ReleaseStatus}" Width="80" />
          <DataGridTextColumn Header="{loc:Loc Col_Size}" Binding="{Binding Size}" Width="100" />
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Text="{loc:Loc Empty_CatalogPackages}"
                 Style="{StaticResource EmptyStateStyle}"
                 Visibility="{Binding IsPackagesEmpty, Converter={StaticResource BoolToVis}}" />
    </Grid>
  </DockPanel>
</UserControl>
