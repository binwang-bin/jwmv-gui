<Application x:Class="Jwmv.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Jwmv.Gui.Views"
             xmlns:vm="clr-namespace:Jwmv.Gui.ViewModels">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Colors.xaml" />
        <ResourceDictionary Source="Themes/Icons.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
        <views:OverviewView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:CatalogViewModel}">
        <views:CatalogView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:InstalledViewModel}">
        <views:InstalledView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:DoctorViewModel}">
        <views:DoctorView />
      </DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
      </DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
